# Default local Functional-test configuration used by `make test-functional`.
# Keep the committed password empty. For private credentials, use a separate
# configuration file and pass it with `--config` or `DORIS_TEST_CONFIG`.
#
# WARNING: Functional tests create and drop databases, tables, views, materialized
# views, users, grants, and other objects. Use only a dedicated, isolated test
# cluster. The suite owns and drops the fixed database name `cross_db_test`, and
# concurrent runs are not supported. The configured account must be allowed to
# create/drop users and execute GRANT/REVOKE.

DORIS_TEST_HOST=127.0.0.1
DORIS_TEST_PORT=9030
DORIS_TEST_USER=root
DORIS_TEST_PASSWORD=''
DORIS_TEST_SCHEMA=dbt_test
DORIS_TEST_REPLICATION_NUM=1
