# Copy this file to test/doris_test.env and edit the copy.
# Never commit the local file: it can contain a database password.
#
# WARNING: Functional tests create and drop databases, tables, views, materialized
# views, and other objects. The full suite also creates/drops users and changes
# grants. Use only a dedicated, isolated test cluster. The suite owns and drops
# the fixed database name `cross_db_test`, and concurrent runs are not supported.

DORIS_TEST_HOST=127.0.0.1
DORIS_TEST_PORT=9030
DORIS_TEST_USER=root
DORIS_TEST_PASSWORD=''
DORIS_TEST_SCHEMA=dbt_test
DORIS_TEST_REPLICATION_NUM=1

# Optional exact release gate, for example 4.1.3. Leave empty to disable it.
DORIS_TEST_EXPECTED_VERSION=

# core excludes user/grant tests; full runs every Functional test.
DORIS_TEST_SUITE=core

# Read the warning above, use a dedicated cluster, then change NO to YES.
DORIS_TEST_ACKNOWLEDGE_DESTRUCTIVE=NO
